          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sonar_bug_resolution_time_days{environment=\"$env\",team=\"$team\"}",
          "legendFormat": "{{app_name}}",
          "refId": "A"
        }
      ],
      "title": "Mean Time to Close (Sonar → Jira)",
      "type": "barchart"
