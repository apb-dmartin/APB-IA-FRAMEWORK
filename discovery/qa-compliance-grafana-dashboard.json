        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "dependabot_vulnerabilities_open{environment=\"$env\",severity=~\"high|critical\"}",
          "legendFormat": "{{app_name}} - {{severity}}",
          "refId": "A"
        }
      ],
      "title": "Dependency Vulnerabilities (Dependabot)",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "$DS_PROMETHEUS"
      },
      "description": "Average time from bug detection to closure",
      "fieldConfig": {
        "defaults": {
